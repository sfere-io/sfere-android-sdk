#!/bin/sh
#
# Pre-commit hook:
#   1. refuse a commit whose staged files name the ingestion vendor (company rule:
#      say "ingestion endpoint");
#   2. run ktlint's formatter on the staged Kotlin files and re-stage what it rewrote;
#   3. regenerate the public API dump (sfere-analytics/api/sfere-analytics.api)
#      and stage it when the SDK's main sources are staged, aborting the commit if
#      the dump fails (the code does not compile).
#
# CI's "Kotlin style" and "API contract" jobs are the real gates; this is fast
# feedback at commit time. detekt, lint and the tests stay CI-and-on-demand.
#
# Install once per clone:
#
#     git config core.hooksPath .githooks
#
# Gradle needs JDK 17. JAVA_HOME is honoured when set; on macOS the hook falls back
# to /usr/libexec/java_home -v 17. `git commit --no-verify` skips the hook.

set -e

cd "$(git rev-parse --show-toplevel)"

if [ -z "${JAVA_HOME:-}" ] && [ -x /usr/libexec/java_home ]; then
    JAVA_HOME="$(/usr/libexec/java_home -v 17 2>/dev/null || true)"
    export JAVA_HOME
fi

# --- vendor names -----------------------------------------------------------
# Staged content only (the index, not the working tree).
# Spelled in pieces so this file does not match its own check.
vendor_pattern='jit''su|air''byte|click''house'
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -n "$staged" ]; then
    hits="$(printf '%s\n' "$staged" | while IFS= read -r f; do
        git show ":$f" | grep -n -i -E "$vendor_pattern" | sed "s|^|$f:|" || true
    done)"
    if [ -n "$hits" ]; then
        printf '%s\n' "$hits" >&2
        echo "pre-commit: the ingestion vendor is named above. Say 'ingestion endpoint' (rule in CLAUDE.md)." >&2
        exit 1
    fi
fi

# --- Kotlin style -------------------------------------------------------------
if ! git diff --cached --quiet --diff-filter=ACMR -- '*.kt' '*.kts'; then
    ./gradlew ktlintFormat -q --console=plain
    # Re-stage the (possibly rewritten) files so the commit holds the formatted code.
    # Working-tree semantics: unstaged hunks of these files are staged along with them.
    git diff --cached --name-only --diff-filter=ACMR -z -- '*.kt' '*.kts' \
        | xargs -0 -r git add --
fi

# --- public API dump ----------------------------------------------------------
# sfere-analytics/api/sfere-analytics.api is generated, and apiDump is its only
# writer. When the SDK's sources are staged, regenerate it and stage the result, so
# the commit carries a dump that matches its code (CI's apiCheck fails on a stale one).
if ! git diff --cached --quiet --diff-filter=ACMRD -- 'sfere-analytics/src/main/*' sfere-analytics/build.gradle.kts; then
    if ! ./gradlew :sfere-analytics:apiDump -q --console=plain; then
        echo "pre-commit: apiDump failed, so the public API dump cannot be regenerated." >&2
        echo "pre-commit: fix the error above (run: ./gradlew :sfere-analytics:apiDump) and commit again." >&2
        exit 1
    fi
    git add -- sfere-analytics/api/
fi
